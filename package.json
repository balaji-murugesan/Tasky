{
  "name": "tasky",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo app for learning the autonomous verify-loop (spec -> code -> verify -> screenshots -> PR -> auto-merge)",
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "tsx scripts/screenshots.ts",
    "app:up": "bash scripts/run-app.sh up",
    "app:down": "bash scripts/run-app.sh down",
    "app:status": "bash scripts/run-app.sh status",
    "risk": "node scripts/risk-classify.mjs",
    "verify": "npm run typecheck && npm test && npm run e2e"
  },
  "dependencies": {
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^2.0.0",
    "@playwright/test": "^1.48.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
